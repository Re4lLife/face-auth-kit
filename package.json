{
  "name": "face-auth-kit",
  "version": "1.0.0",
  "description": "Facial recognition authentication components powered by AWS Rekognition Face Liveness",
  "author": "Osokor Fortune",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "keywords": [
    "face-recognition",
    "authentication",
    "aws-rekognition",
    "face-liveness",
    "react",
    "nextjs"
  ],
  "scripts": {
    "build:lib": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@aws-amplify/ui-react-liveness": "^3.6.5",
    "@aws-sdk/client-rekognition": "^3.1045.0",
    "@aws-sdk/client-sts": "^3.1047.0",
    "framer-motion": "^12.38.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "next": ">=13"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}